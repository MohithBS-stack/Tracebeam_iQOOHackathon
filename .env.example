# ══════════════════════════════════════════════════════════════════════════════
# Tracebeam – .env.example
# Team Lagnarok | iQOO Hackathon 2026 Grand Finale
#
# HOW TO USE THIS FILE
# ────────────────────
# 1. Copy this file to .env in the repo root:
#        cp .env.example .env          (macOS / Linux / Git Bash)
#        copy .env.example .env        (Windows cmd)
#        Copy-Item .env.example .env   (PowerShell)
#
# 2. Fill in only the values marked as REQUIRED for your build target.
#    Values marked OPTIONAL can be left commented out; the code has fallbacks.
#
# 3. Never commit .env. It is listed in .gitignore.
#    Use fake secrets for all test / corpus data (see docs/TECHNICAL.md §12).
#
# 4. Phase 1 (web prototype) runs with NO API keys and NO server.
#    The only values you might set for Phase 1 are the feature flags below.
#
# 5. Finale build (Android) also has no INTERNET permission and no API keys.
#    The Android build reads nothing from .env at runtime; these values are
#    used only by local dev scripts and CI checks.
#
# ══════════════════════════════════════════════════════════════════════════════


# ── PHASE 1: WEB PROTOTYPE ────────────────────────────────────────────────────
# Run with: npx serve prototype/phase1
# Test with: node --test prototype/phase1/tests

# Port for the local dev server.
# Default: 3000 (set by npx serve automatically; override only if 3000 is busy)
# OPTIONAL
# PORT=3000

# Enable the optional camera-OCR path (Tesseract.js).
# Set to "true" only when running on localhost; the OCR worker loads from
# jsDelivr and requires a non-sandboxed origin.
# OPTIONAL – default is "false" (clipboard is the primary capture path)
# VITE_ENABLE_OCR=false

# Enable the optional Web Speech API voice-note path.
# Chrome requires a network connection for its cloud ASR in Phase 1.
# The app saves audio even without a transcript, so this is safe to leave off.
# OPTIONAL – default is "false"
# VITE_ENABLE_SPEECH=false

# Scripted peer count for the mesh simulator (BroadcastChannel demo).
# Increase to 3–5 to stress-test matching with more fake peers.
# OPTIONAL – default is 2
# VITE_PEER_COUNT=2


# ── CORPUS & TESTING ──────────────────────────────────────────────────────────
# Path to the corpus directory used by the signal-engine tests.
# You normally do not need to change this.
# OPTIONAL – default is "prototype/phase1/corpus"
# CORPUS_PATH=prototype/phase1/corpus

# Set to "true" to print per-trace debug output during tests (verbose mode).
# OPTIONAL – default is "false"
# TEST_VERBOSE=false


# ── FINALE BUILD: ANDROID ONLY ────────────────────────────────────────────────
# These values are consumed by Gradle scripts and local tooling only.
# The app itself has NO INTERNET permission and reads no secrets at runtime.

# Android SDK root on your local machine.
# On most macOS / Linux setups the SDK lives in ~/Library/Android/sdk or ~/Android/Sdk.
# On Windows it is typically C:\Users\<you>\AppData\Local\Android\Sdk.
# Gradle also reads this from local.properties (android/local.properties),
# which is gitignored. Set one or the other, not both.
# REQUIRED for Finale build if android/local.properties does not exist.
# ANDROID_SDK_ROOT=/path/to/your/Android/sdk

# Keystore path and credentials for signing the release APK.
# Use a DEBUG keystore during development; the release keystore is for
# final submission only. Never commit the keystore file.
# REQUIRED for a signed release build only (not needed for debug builds).
# RELEASE_KEYSTORE_PATH=/path/to/tracebeam-release.keystore
# RELEASE_KEY_ALIAS=tracebeam
# RELEASE_KEYSTORE_PASSWORD=changeme
# RELEASE_KEY_PASSWORD=changeme

# Optional: path to the on-device LLM model file (Tier 3, not on critical path).
# This is the .task / .bin file copied to the phone via Office Kit file transfer.
# The build script uses this to include it in the APK assets during development.
# Leave commented out if you are not working on the LLM tier.
# OPTIONAL
# LLM_MODEL_PATH=/path/to/gemma-4e2b-it-cpu.task


# ── CI / AUTOMATION ───────────────────────────────────────────────────────────
# GitHub Actions or any CI system needs no secrets for Phase 1 (no API calls).
# Add this block if you later add a CI step that needs to sign an APK.

# CI only – set these as encrypted repo secrets in GitHub, not in this file.
# CI_KEYSTORE_BASE64=          # base64-encoded keystore (GitHub secret)
# CI_KEY_ALIAS=                # GitHub secret
# CI_KEYSTORE_PASSWORD=        # GitHub secret
# CI_KEY_PASSWORD=             # GitHub secret


# ── HONEST CLAIMS REMINDER ────────────────────────────────────────────────────
# Per AGENTS.md hard rule 5:
# Never write "NPU" in code or docs unless docs/evidence/ contains a log
# showing the NPU backend ran. Label CPU or GPU runs as such.
# There is no env var for this – it is a code review rule, not a runtime flag.
